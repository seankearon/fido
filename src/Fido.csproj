<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Fido</RootNamespace>
        <AssemblyName>Fido</AssemblyName>
        <Product>Fido</Product>
        <AssemblyTitle>Fido — Flight Dynamics Officer</AssemblyTitle>
        <Description>Resolves a branch name to its worktree on disk and opens it in Rider.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\assets\fido.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Native AOT: `dotnet publish -r <rid> -c Release` produces a self-contained native exe.
             The app is AOT-safe (compiled bindings + source-generated JSON).
             PublishAot is gated to publish-only because, when set unconditionally, the SDK stamps
             IsDynamicCodeSupported=false into every build's runtimeconfig — which breaks the Avalonia
             XAML previewer (it compiles XAML at runtime via Reflection.Emit). `dotnet publish` sets
             _IsPublishing=true, so the native-AOT publish output is unaffected. IsAotCompatible keeps the
             trim/AOT analyzers running on ordinary builds so AOT-safety is still enforced at compile time. -->
        <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- ILC emits native code for the target and refuses to do it across operating systems:
             publishing osx-* from Windows fails with "Cross-OS native compilation is not supported".
             So for the mac runtimes AOT is on exactly when the build is happening on a Mac, and the
             cross-built ones fall back to trimmed + self-contained — larger and JIT-started, but it
             runs, which is more than can be said for a publish that cannot compile. This is what
             lets the Package stage of Fido.Build produce a .dmg from a Windows machine. -->
        <PublishAot Condition="'$(PublishAot)' == 'true' And ('$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64')">$([MSBuild]::IsOSPlatform(OSX))</PublishAot>
        <PublishTrimmed Condition="'$(_IsPublishing)' == 'true' And '$(PublishAot)' != 'true' And '$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
        <SelfContained Condition="'$(_IsPublishing)' == 'true' And '$(PublishAot)' != 'true' And '$(RuntimeIdentifier)' != ''">true</SelfContained>
    </PropertyGroup>

    <!-- The header shows the running build's version, so an ordinary build needs one. Only the
         release build supplies it (Fido.Build generates a root Directory.Build.props from ver.txt,
         which is imported before this file and so wins the condition below); everything else - the
         IDE, CI, `dotnet run` - would otherwise be stamped with the SDK's 1.0.0 default and claim a
         version Fido has never released. ver.txt is the same single source of truth either way. -->
    <PropertyGroup Condition="'$(Version)' == '' And Exists('$(MSBuildThisFileDirectory)..\ver.txt')">
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\ver.txt').Trim())</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Brand assets live at the repo root; link them into the Fido namespace as avares resources. -->
        <AvaloniaResource Include="..\assets\png\fido-icon-256.png" Link="Assets\fido-icon-256.png" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Fido.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <!-- Polly.Core is the lean, Native-AOT/trim-safe core (no DI/reflection) — used to retry the
             transient failures git's deletion commands hit (a still-locked worktree file, a racing ref
             .lock, a network blip deleting the origin branch). -->
        <PackageReference Include="Polly.Core" Version="8.7.0" />
    </ItemGroup>

</Project>
