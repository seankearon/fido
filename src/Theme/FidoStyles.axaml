<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section / field label (12/600 with a whisper of tracking, per the redesign type scale) -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextLabel}" />
    </Style>

    <!-- Mono text input -->
    <Style Selector="TextBox.fido">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextBody}" />
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="CaretBrush" Value="{DynamicResource FidoAccentText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource FidoAccentTintSeg}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource FidoPlaceholder}" />
    </Style>
    <Style Selector="TextBox.fido /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
    </Style>
    <Style Selector="TextBox.fido:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
    </Style>
    <Style Selector="TextBox.fido:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoFocusBorder}" />
    </Style>
    <Style Selector="TextBox.fido:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FidoFocusBorder}" />
    </Style>

    <!-- Mono autocomplete input (branch / solution MRU) — mirrors TextBox.fido on the inner text box -->
    <Style Selector="AutoCompleteBox.fido">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextBody}" />
    </Style>
    <Style Selector="AutoCompleteBox.fido /template/ TextBox#PART_TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextBody}" />
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="CaretBrush" Value="{DynamicResource FidoAccentText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource FidoAccentTintSeg}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource FidoPlaceholder}" />
    </Style>

    <!-- The main screen's hero-sized discovery inputs (branch / solution filter): 52px tall,
         radius 10, 1.5px border, 15.5px text, amber focus border. Layered over .fido. -->
    <Style Selector="AutoCompleteBox.hero /template/ TextBox#PART_TextBox">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="AutoCompleteBox.hero /template/ TextBox#PART_TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="0 0 0 3 #2EF4A62A" />
    </Style>
    <Style Selector="AutoCompleteBox.fido /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
    </Style>
    <Style Selector="AutoCompleteBox.fido /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
    </Style>
    <Style Selector="AutoCompleteBox.fido /template/ TextBox#PART_TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FidoFocusBorder}" />
    </Style>

    <!-- Autocomplete dropdown surface + items -->
    <Style Selector="AutoCompleteBox.fido /template/ ListBox#PART_SelectingItemsControl">
        <Setter Property="Background" Value="{DynamicResource FidoInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="AutoCompleteBox.fido ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextBody}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="AutoCompleteBox.fido ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintBtn}" />
    </Style>
    <Style Selector="AutoCompleteBox.fido ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintSeg}" />
    </Style>

    <!-- Inline "forget this entry" (✕) affordance inside the autocomplete dropdown items -->
    <Style Selector="Button.mrudel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.mrudel Path">
        <Setter Property="Stroke" Value="{DynamicResource FidoTextMuted}" />
    </Style>
    <Style Selector="Button.mrudel /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.mrudel:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.mrudel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoNoGoBg}" />
    </Style>
    <Style Selector="Button.mrudel:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource FidoNoGo}" />
    </Style>

    <!-- Primary (amber) button -->
    <Style Selector="Button.primary">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FidoButtonText}" />
        <Setter Property="Background" Value="{DynamicResource FidoAccent}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FidoButtonText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccentStrong}" />
    </Style>

    <!-- Secondary / ghost button (dialog Cancel) -->
    <Style Selector="Button.secondary">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FidoSecondaryBtnText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="20,9" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintBtn}" />
    </Style>

    <!-- Destructive (red) button — worktree/branch deletion -->
    <Style Selector="Button.danger">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FidoNoGoText}" />
        <Setter Property="Background" Value="{DynamicResource FidoNoGoBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoNoGo}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoNoGoBg}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoNoGo}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FidoButtonText}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoNoGo}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FidoButtonText}" />
    </Style>

    <!-- Segmented control option (RadioButton rendered as a pill segment) -->
    <Style Selector="RadioButton.segment">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextMuted}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="seg" Background="Transparent" CornerRadius="6" Padding="18,7">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource FidoAccentStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#seg">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintSeg}" />
    </Style>

    <!-- Flight-log lines (level-coded via conditional classes; muted is the default) -->
    <Style Selector="TextBlock.logline">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{DynamicResource FidoLogMuted}" />
    </Style>
    <Style Selector="TextBlock.logline.accent">
        <Setter Property="Foreground" Value="{DynamicResource FidoLogAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.logline.ok">
        <Setter Property="Foreground" Value="{DynamicResource FidoLogOk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.logline.warn">
        <Setter Property="Foreground" Value="{DynamicResource FidoLogWarn}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.logline.plain">
        <Setter Property="Foreground" Value="{DynamicResource FidoLogPlain}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Header icon button (cog) -->
    <Style Selector="Button.iconbtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.iconbtn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoGearHoverBg}" />
    </Style>

    <!-- ================= Main-screen redesign components ================= -->

    <!-- Discovery status pill (idle / scanning / found / not-found via extra classes) -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill.idle">
        <Setter Property="Background" Value="{DynamicResource FidoPillIdleBg}" />
    </Style>
    <Style Selector="Border.pill.idle TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoPillIdleText}" />
    </Style>
    <Style Selector="Border.pill.scan">
        <Setter Property="Background" Value="{DynamicResource FidoPillScanBg}" />
    </Style>
    <Style Selector="Border.pill.scan TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoPillScanText}" />
    </Style>
    <Style Selector="Border.pill.found">
        <Setter Property="Background" Value="{DynamicResource FidoPillFoundBg}" />
    </Style>
    <Style Selector="Border.pill.found TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoPillFoundText}" />
    </Style>
    <Style Selector="Border.pill.notfound">
        <Setter Property="Background" Value="{DynamicResource FidoPillNotFoundBg}" />
    </Style>
    <Style Selector="Border.pill.notfound TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoPillNotFoundText}" />
    </Style>

    <!-- Indeterminate spinner: a stroked arc rotating about its centre -->
    <Style Selector="Path.spinner">
        <Setter Property="Stroke" Value="{DynamicResource FidoTextMuted}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Selectable discovery target cards -->
    <Style Selector="ListBox.targets">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.targets ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="card" Background="{DynamicResource FidoChipBg}"
                        BorderBrush="{DynamicResource FidoCardBorder}"
                        BorderThickness="1.5" CornerRadius="11" Padding="15,14">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.targets ListBoxItem:pointerover /template/ Border#card">
        <Setter Property="Background" Value="{DynamicResource FidoCardHoverBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoSelectedBorder}" />
    </Style>
    <Style Selector="ListBox.targets ListBoxItem:selected /template/ Border#card">
        <Setter Property="Background" Value="{DynamicResource FidoSelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoSelectedBorder}" />
    </Style>
    <!-- The card's trailing radio indicator: ring always, dot only when selected -->
    <Style Selector="ListBox.targets ListBoxItem Ellipse.radioring">
        <Setter Property="Stroke" Value="{DynamicResource FidoRadioRing}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="ListBox.targets ListBoxItem:selected Ellipse.radioring">
        <Setter Property="Stroke" Value="{DynamicResource FidoRadioDot}" />
    </Style>
    <Style Selector="ListBox.targets ListBoxItem Ellipse.radiodot">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Fill" Value="{DynamicResource FidoRadioDot}" />
    </Style>
    <Style Selector="ListBox.targets ListBoxItem:selected Ellipse.radiodot">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Worktree / main-clone kind chips on a target card -->
    <Style Selector="Border.kindchip">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kindchip TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.kindchip.worktree">
        <Setter Property="Background" Value="{DynamicResource FidoWorktreeChipBg}" />
    </Style>
    <Style Selector="Border.kindchip.worktree TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoWorktreeText}" />
    </Style>
    <Style Selector="Border.kindchip.clone">
        <Setter Property="Background" Value="{DynamicResource FidoCloneChipBg}" />
    </Style>
    <Style Selector="Border.kindchip.clone TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoCloneText}" />
    </Style>

    <!-- Solution chips (horizontal pick-one row; the Folder chip rides along at the end) -->
    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="chip" Background="{DynamicResource FidoChipBg}"
                        BorderBrush="{DynamicResource FidoChipBorder}"
                        BorderThickness="1.5" CornerRadius="8" Padding="11,4">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.chips ListBoxItem TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextSecondary}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ Border#chip">
        <Setter Property="BorderBrush" Value="{DynamicResource FidoSelectedBorder}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ Border#chip">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintBtn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoSelectedBorder}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FidoAccentStrong}" />
    </Style>

    <!-- Hero open button (the default tool). The drop shadow lives on a wrapping Border in the page. -->
    <Style Selector="Button.hero">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FidoHeroText}" />
        <Setter Property="Background" Value="{DynamicResource FidoHeroBg}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.hero /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoHeroBg}" />
    </Style>
    <Style Selector="Button.hero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoHeroBgHover}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FidoHeroText}" />
    </Style>
    <Style Selector="Button.hero:pressed">
        <Setter Property="RenderTransform" Value="translateY(1px)" />
    </Style>
    <Style Selector="Button.hero:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Tool-grid buttons (the non-default tools) -->
    <Style Selector="Button.tool">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="Background" Value="{DynamicResource FidoChipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoCardBorder}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="13,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoChipBg}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoAccentTintBtn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoSelectedBorder}" />
    </Style>
    <Style Selector="Button.tool:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Delete row: red-outline button, and its solid confirm counterpart -->
    <Style Selector="Button.dangerline">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FidoDangerText}" />
        <Setter Property="Background" Value="{DynamicResource FidoDangerSoftBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoDangerBorder}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.dangerline /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoDangerSoftBg}" />
    </Style>
    <Style Selector="Button.dangerline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoDangerSoftBgHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoDangerBorderHover}" />
    </Style>
    <Style Selector="Button.dangerline:disabled">
        <Setter Property="Foreground" Value="{DynamicResource FidoDangerDisabledText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoDangerDisabledBg}" />
    </Style>
    <Style Selector="Button.dangerline:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoDangerDisabledBg}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FidoDangerDisabledText}" />
    </Style>

    <Style Selector="Button.dangersolid">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource FidoDangerSolid}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style Selector="Button.dangersolid /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoDangerSolid}" />
    </Style>
    <Style Selector="Button.dangersolid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoDangerSolidHover}" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- White cancel button inside the delete confirm strip -->
    <Style Selector="Button.confirmcancel">
        <Setter Property="FontFamily" Value="{DynamicResource FidoMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FidoTextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource FidoChipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FidoInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style Selector="Button.confirmcancel /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoChipBg}" />
    </Style>
    <Style Selector="Button.confirmcancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FidoGearHoverBg}" />
    </Style>

</Styles>
