<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="using:Iciclecreek.Terminal"
        x:Class="Fido.Views.RunnerWindow"
        Width="900" Height="560"
        MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/fido-icon-256.png"
        WindowDecorations="Full"
        FontFamily="{DynamicResource FidoMono}"
        Background="{DynamicResource FidoWindowBg}">

    <!-- Runner: the branch's own script, run at the selected worktree, in Fido's window.
         Header names what is running and where; the terminal takes the rest. Unlike the main
         window this one is a real resizable viewport - a terminal is sized in cells, so it
         cannot live under SizeToContent. -->
    <Grid Margin="16,14,16,14" RowDefinitions="Auto,*,Auto">

        <!-- ===================== Header: what is running, and where ===================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <Border Grid.Column="0" Background="{DynamicResource FidoChipBg}" CornerRadius="6"
                    Padding="9,4" VerticalAlignment="Center">
                <TextBlock x:Name="BranchChip" FontSize="12" FontWeight="600"
                           Foreground="{DynamicResource FidoTextSecondary}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="CommandText" FontSize="13.5" FontWeight="600"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FidoTextPrimary}" />
                <TextBlock x:Name="FolderText" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FidoTextMuted}" />
            </StackPanel>
        </Grid>

        <!-- ===================== The terminal itself ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource FidoLogBg}"
                BorderBrush="{DynamicResource FidoLogBorder}" BorderThickness="1"
                CornerRadius="10" Padding="10,8" ClipToBounds="True">
            <term:TerminalControl x:Name="Terminal"
                                  FontFamily="{DynamicResource FidoMono}"
                                  FontSize="13"
                                  Background="{DynamicResource FidoLogBg}"
                                  Foreground="{DynamicResource FidoTextPrimary}"
                                  AutoScrollToBottom="True"
                                  ProcessExited="OnProcessExited" />
        </Border>

        <!-- ===================== Footer: state + the escape hatch ===================== -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Border Grid.Column="0" x:Name="StatePill" Classes="pill scan" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Text="running" />
            </Border>
            <!-- Fido is a launcher first: if the in-app console isn't the right place for this,
                 one click hands the same command to the terminal the user actually configured. -->
            <Button Grid.Column="2" x:Name="HandOffButton" Classes="secondary" Padding="14,6"
                    Content="Open in my terminal" Click="OnHandOffClick" Margin="0,0,8,0" />
            <Button Grid.Column="3" x:Name="CloseButton" Classes="secondary" Padding="14,6"
                    Content="Close" Click="OnCloseClick" />
        </Grid>

    </Grid>
</Window>
