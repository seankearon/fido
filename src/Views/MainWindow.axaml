<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fido.ViewModels"
        xmlns:sys="using:System"
        x:Class="Fido.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="720" SizeToContent="Height"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/fido-icon-256.png"
        Title="Fido"
        WindowDecorations="Full"
        FontFamily="{DynamicResource FidoMono}"
        Background="{DynamicResource FidoWindowBg}">

    <!-- One window, one screen: header → inputs → discovery → open actions → delete → flight log.
         The upper stack scrolls if the discovery list outgrows the window; the flight log sits near the
         bottom and takes whatever vertical slack the window has beyond the upper stack (see
         MainWindow.UpdateFlightLogHeight); the auto-close countdown pins beneath it. -->
    <Grid x:Name="RootGrid" Margin="30,26,30,24" RowDefinitions="*,Auto,Auto">

        <ScrollViewer x:Name="MainScroller" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="UpperStack" Spacing="22">

                <!-- ============================= 1. Header ============================= -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Logo tile: the amber rising line + arrow on the dark brand square -->
                    <Border Width="52" Height="52" CornerRadius="13"
                            Background="{DynamicResource FidoLogoTileBg}" VerticalAlignment="Center">
                        <Viewbox Width="30" Height="30">
                            <Canvas Width="120" Height="120">
                                <Path Data="{StaticResource FidoGlyphCurve}"
                                      Stroke="{DynamicResource FidoBrandStroke}" StrokeThickness="9"
                                      StrokeLineCap="Round" />
                                <Path Data="M66,31 L88,27 L82,52"
                                      Stroke="{DynamicResource FidoBrandStroke}" StrokeThickness="9"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="fido" FontSize="26" FontWeight="ExtraBold" LetterSpacing="-0.5"
                                   Foreground="{DynamicResource FidoTextPrimary}" />
                        <TextBlock Text="Flight Dynamics Officer — guiding Rider to a safe landing"
                                   FontSize="12.5" Foreground="{DynamicResource FidoTagline}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Gear: default-tool popover (with a door through to full settings) -->
                    <Button Grid.Column="2" x:Name="GearButton" Classes="iconbtn" Width="36" Height="36"
                            VerticalAlignment="Top" ToolTip.Tip="Default tool &amp; settings">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource FidoTextMuted}"
                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
                                <StackPanel Width="280" Spacing="10" Margin="4">
                                    <TextBlock Classes="label" Text="Default tool" />
                                    <ItemsControl ItemsSource="{Binding DefaultToolChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DefaultToolChoice">
                                                <RadioButton GroupName="DefaultTool" FontSize="13" Padding="6,3"
                                                             Content="{Binding Name}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource FidoTextMuted}" TextWrapping="Wrap"
                                               Text="A launch flag like --tool rider overrides this for a single run." />
                                    <Button Classes="secondary" Content="All settings…" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Click="OnAllSettingsClick" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- ============================= 2. Inputs ============================= -->
                <Grid ColumnDefinitions="1.7*,1*">
                    <StackPanel Spacing="8" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="Branch name" />
                        <AutoCompleteBox x:Name="BranchBox" Classes="fido hero"
                                         Text="{Binding BranchName, Mode=TwoWay}"
                                         ItemsSource="{Binding RecentBranches}"
                                         FilterMode="Contains" MinimumPrefixLength="0"
                                         PlaceholderText="type a branch to discover">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Classes="mrudel" Tag="branch" Focusable="False"
                                                Click="OnRemoveMruItem" ToolTip.Tip="Forget this branch name">
                                            <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.4"
                                                  StrokeLineCap="Round" Data="M0,0 L9,9 M9,0 L0,9" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
                        <TextBlock Classes="label">
                            <Run Text="Solution " /><Run Text="· optional" Foreground="{DynamicResource FidoTextDim}" />
                        </TextBlock>
                        <AutoCompleteBox x:Name="SolutionBox" Classes="fido hero"
                                         Text="{Binding SolutionFilter, Mode=TwoWay}"
                                         ItemsSource="{Binding RecentSolutions}"
                                         FilterMode="Contains" MinimumPrefixLength="0"
                                         PlaceholderText="filter solutions">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Classes="mrudel" Tag="solution" Focusable="False"
                                                Click="OnRemoveMruItem" ToolTip.Tip="Forget this solution name">
                                            <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.4"
                                                  StrokeLineCap="Round" Data="M0,0 L9,9 M9,0 L0,9" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </StackPanel>
                </Grid>

                <!-- ========================= 3. Discovery results ========================= -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="label" Text="Discovery" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="{DynamicResource FidoHairline}"
                                VerticalAlignment="Center" Margin="10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Classes="pill idle" IsVisible="{Binding IsIdle}">
                                <TextBlock Text="idle" />
                            </Border>
                            <Border Classes="pill scan" IsVisible="{Binding IsScanning}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="spinner" Width="12" Height="12"
                                          Data="M6,1 A5,5 0 1 1 1,6" VerticalAlignment="Center" />
                                    <TextBlock Text="scanning" />
                                </StackPanel>
                            </Border>
                            <Border Classes="pill found" IsVisible="{Binding IsFound}">
                                <TextBlock Text="{Binding FoundChipText}" />
                            </Border>
                            <Border Classes="pill notfound" IsVisible="{Binding IsNotFound}">
                                <TextBlock Text="not found" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Idle: dashed placeholder -->
                    <Grid IsVisible="{Binding IsIdle}">
                        <Rectangle Stroke="{DynamicResource FidoCardDashedBorder}" StrokeThickness="1.5"
                                   StrokeDashArray="4,3" RadiusX="11" RadiusY="11" Fill="Transparent" />
                        <TextBlock Margin="18,16" FontSize="12.5" Foreground="{DynamicResource FidoTextMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Enter a branch name above. Fido scans every configured working tree and clone to find where that branch is checked out — nothing opens until it does." />
                    </Grid>

                    <!-- Scanning: soft card with spinner -->
                    <Border IsVisible="{Binding IsScanning}" Background="{DynamicResource FidoPanelBg}"
                            BorderBrush="{DynamicResource FidoPanelBorder}" BorderThickness="1"
                            CornerRadius="11" Padding="16,14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="spinner" Width="16" Height="16"
                                  Data="M8,1.5 A6.5,6.5 0 1 1 1.5,8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScanningBody}" FontSize="13"
                                       Foreground="{DynamicResource FidoTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Not found: warning card -->
                    <Border IsVisible="{Binding IsNotFound}" Background="{DynamicResource FidoNotFoundBg}"
                            BorderBrush="{DynamicResource FidoNotFoundBorder}" BorderThickness="1.5"
                            CornerRadius="11" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding NotFoundBody}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FidoNotFoundText}" TextWrapping="Wrap" />
                            <TextBlock Text="Double-check the name — no scanned repo has this branch, locally or on origin."
                                       FontSize="12" Foreground="{DynamicResource FidoNotFoundSub}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Found: (optional) helper strip + selectable target cards -->
                    <StackPanel IsVisible="{Binding IsFound}" Spacing="10">
                        <Border IsVisible="{Binding HasMultipleTargets}" Background="{DynamicResource FidoHelperBg}"
                                CornerRadius="9" Padding="12,8">
                            <TextBlock Text="{Binding MultiTargetHelperText}"
                                       FontSize="12.5" Foreground="{DynamicResource FidoHelperText}" TextWrapping="Wrap" />
                        </Border>

                        <ListBox Classes="targets" ItemsSource="{Binding Targets}"
                                 SelectionMode="Single,AlwaysSelected"
                                 SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetCard">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- Icon tile: git-branch for a worktree, home for the main clone -->
                                        <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{DynamicResource FidoWorktreeTileBg}"
                                                IsVisible="{Binding IsWorktree}">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource FidoWorktreeText}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M6,3 V15 M18,9 A9,9 0 0 1 9,18 M18,3 a3,3 0 1 1 -0.01,0 M6,15 a3,3 0 1 1 -0.01,0" />
                                        </Border>
                                        <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{DynamicResource FidoCloneTileBg}"
                                                IsVisible="{Binding IsMainClone}">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource FidoCloneText}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M3,9 L12,2 L21,9 V20 a1,1 0 0 1 -1,1 H4 a1,1 0 0 1 -1,-1 Z M9,21 V12 H15 V21" />
                                        </Border>
                                        <!-- New worktree: the branch exists here but isn't checked out — a plus glyph -->
                                        <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{DynamicResource FidoHelperBg}"
                                                IsVisible="{Binding IsNewWorktree}">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource FidoWorktreeText}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M12,3 a9,9 0 1 1 -0.01,0 M12,8 V16 M8,12 H16" />
                                        </Border>
                                        <!-- Switch the main clone onto the branch — opposing arrows -->
                                        <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{DynamicResource FidoCloneTileBg}"
                                                IsVisible="{Binding IsSwitchClone}">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource FidoCloneText}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M4,7 H17 M13,3 L17,7 L13,11 M20,17 H7 M11,13 L7,17 L11,21" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FidoTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="12"
                                                       Foreground="{DynamicResource FidoLogMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Classes="kindchip"
                                                Classes.worktree="{Binding IsWorktree}"
                                                Classes.clone="{Binding IsMainClone}"
                                                Classes.newwt="{Binding IsNewWorktree}"
                                                Classes.switchwt="{Binding IsSwitchClone}">
                                            <TextBlock Text="{Binding KindLabel}" />
                                        </Border>

                                        <!-- Radio indicator: amber ring + dot when selected -->
                                        <Grid Grid.Column="3" Width="17" Height="17" Margin="12,0,2,0" VerticalAlignment="Center">
                                            <Ellipse Classes="radioring" Width="17" Height="17" />
                                            <Ellipse Classes="radiodot" Width="9" Height="9" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>

                <!-- ========================= 4. Open actions ========================= -->
                <StackPanel Spacing="12">

                    <!-- Locked: the gate, with the reason doubling as the message -->
                    <Border IsVisible="{Binding IsLocked}" Background="{DynamicResource FidoPanelBg}"
                            BorderBrush="{DynamicResource FidoPanelBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="16,20">
                        <TextBlock Text="{Binding LockReason}" HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource FidoTextMuted}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Target / solution context strip (only meaningful once something was found) -->
                    <Border IsVisible="{Binding IsFound}"
                            Background="{DynamicResource FidoPanelBg}" BorderBrush="{DynamicResource FidoPanelBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Classes="label" Text="OPEN" VerticalAlignment="Center" />
                                    <!-- Chip sits directly in the star column so it ellipsises to the width actually
                                         available and never overflows as the window narrows toward its minimum. -->
                                    <Border Grid.Column="1" Background="{DynamicResource FidoChipBg}"
                                            BorderBrush="{DynamicResource FidoChipBorder}" BorderThickness="1"
                                            CornerRadius="7" Padding="10,4" Margin="10,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedPath}" FontSize="12.5"
                                                   Foreground="{DynamicResource FidoTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPath}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <!-- Copy the selected working-tree path to the clipboard -->
                                        <Button x:Name="CopyPathButton" Classes="iconaction" Click="OnCopyPathClick"
                                                IsTabStop="False" ToolTip.Tip="Copy path to clipboard">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Data="M11,9 L20,9 A2,2 0 0 1 22,11 L22,20 A2,2 0 0 1 20,22 L11,22 A2,2 0 0 1 9,20 L9,11 A2,2 0 0 1 11,9 Z M5,15 L4,15 A2,2 0 0 1 2,13 L2,4 A2,2 0 0 1 4,2 L13,2 A2,2 0 0 1 15,4 L15,5" />
                                        </Button>
                                        <TextBlock Text="{Binding SelectedKindLabel}" FontSize="12"
                                                   Foreground="{DynamicResource FidoTextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel IsVisible="{Binding HasSolutionChips}" Spacing="9">
                                    <Border Height="1" Background="{DynamicResource FidoHairline}" />
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="Rider / Visual Studio open" FontSize="11.5"
                                                   Foreground="{DynamicResource FidoTextMuted}"
                                                   Margin="0,7,12,0" VerticalAlignment="Top" />
                                        <ListBox Grid.Column="1" Classes="chips"
                                                 SelectionMode="Single,AlwaysSelected"
                                                 ItemsSource="{Binding SolutionChips}"
                                                 SelectedItem="{Binding SelectedSolutionChip, Mode=TwoWay}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SolutionChip">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hero open button (the default tool) — visible in every phase, enabled only
                             when discovery has found the branch (the lock card above states why) -->
                        <Border IsVisible="{Binding HasHero}" CornerRadius="10"
                                BoxShadow="0 2 0 0 #D5870F, 0 8 16 -7 #99E08514">
                            <Button Classes="hero" Click="OnHeroClick" IsEnabled="{Binding CanOpen}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                    <Path Data="M2,1 L11,6.5 L2,12 Z" Fill="{DynamicResource FidoHeroText}"
                                          Width="12" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding HeroLabel}" Margin="10,0,9,0"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource FidoHeroPillBg}"
                                            CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="default" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FidoHeroPillText}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding HeroTool.Gesture}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="11.5" Foreground="{DynamicResource FidoHeroPillText}" />
                                </Grid>
                            </Button>
                        </Border>

                        <TextBlock IsVisible="{Binding ShowNoDefaultNote}" FontSize="12"
                                   Foreground="{DynamicResource FidoTextMuted}" TextWrapping="Wrap"
                                   Text="No default tool set — every option is equal weight. Pick one, set a default in ⚙, or pass --tool on launch." />

                        <!-- The remaining tools, three abreast — like the hero, always on show, gated on found -->
                        <ItemsControl ItemsSource="{Binding GridTools}" IsEnabled="{Binding CanOpen}"
                                      Margin="0,0,-10,-10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditorLaunchOption">
                                    <Button Classes="tool" Margin="0,0,10,10" Click="OnToolClick"
                                            ToolTip.Tip="{Binding Name}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FidoTextBody}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Gesture}" FontSize="11.5"
                                                       Foreground="{DynamicResource FidoTextDim}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ========================= 5. Delete row ========================= -->
                        <StackPanel IsVisible="{Binding ShowDeleteRow}" Spacing="12">
                            <Border Height="1" Background="{DynamicResource FidoSettingsDivider}" Margin="0,4,0,0" />

                            <StackPanel IsVisible="{Binding ShowDeleteButton}" Orientation="Horizontal" Spacing="12">
                                <Button Classes="dangerline" Click="OnDeleteClick" IsTabStop="False"
                                        IsEnabled="{Binding CanDelete}"
                                        Content="🗑  Delete worktree &amp; branch" />
                                <TextBlock IsVisible="{Binding ShowDeleteDisabledNote}" Text="{Binding DeleteDisabledNote}"
                                           FontSize="12" Foreground="{DynamicResource FidoTextMuted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>

                            <!-- In-place two-step confirm: Enter never deletes, only the explicit click -->
                            <Border IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource FidoDangerSoftBg}"
                                    BorderBrush="{DynamicResource FidoDangerBorder}" BorderThickness="1.5"
                                    CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{DynamicResource FidoDangerConfirmText}">
                                        <Run Text="Remove the worktree at " /><Run Text="{Binding DeleteConfirmPath}" FontWeight="Bold" Foreground="{DynamicResource FidoDangerEmphasis}" /><Run Text=" and delete local branch " /><Run Text="{Binding DeleteConfirmBranch}" FontWeight="Bold" Foreground="{DynamicResource FidoDangerEmphasis}" /><Run Text="? This can't be undone." />
                                    </TextBlock>
                                    <TextBlock IsVisible="{Binding HasDeleteConfirmWarnings}"
                                               Text="{Binding DeleteConfirmWarnings}" TextWrapping="Wrap"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FidoDangerEmphasis}" />
                                    <!-- Opt-in: also delete the remote branch — disabled, with a link, when a PR is open -->
                                    <StackPanel IsVisible="{Binding ShowRemoteBranchOption}" Spacing="6">
                                        <CheckBox x:Name="DeleteRemoteCheck" Classes="remoteopt"
                                                  IsChecked="{Binding DeleteRemoteBranch, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanDeleteRemoteBranch}"
                                                  Content="{Binding RemoteBranchOptionText}" />
                                        <StackPanel IsVisible="{Binding HasOpenPullRequest}" Orientation="Horizontal"
                                                    Spacing="8" Margin="26,0,0,0">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource FidoDangerEmphasis}"
                                                       Text="{Binding OpenPullRequestLabel}" />
                                            <Button x:Name="OpenPrButton" Classes="prlink" Click="OnOpenPullRequestClick"
                                                    Content="Open pull request ↗" ToolTip.Tip="{Binding OpenPullRequestUrl}" />
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding HasOpenPullRequest}" Margin="26,0,0,0"
                                                   FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FidoTextMuted}"
                                                   Text="A pull request is open for this branch — close or merge it on GitHub before deleting origin." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Classes="confirmcancel" Content="Cancel" Click="OnDeleteCancelClick"
                                                IsEnabled="{Binding !IsDeleting}" />
                                        <Button Classes="dangersolid" Content="Delete" Click="OnDeleteConfirmClick"
                                                IsEnabled="{Binding !IsDeleting}" IsTabStop="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== 5b. Delete retry strip ==================== -->
                        <!-- What a part-way delete left behind, with another go at just that step. Outside the
                             delete row on purpose: deleting the last card empties the results, and the offer
                             has to outlive it. -->
                        <Border IsVisible="{Binding IsDeleteRetryPending}" Background="{DynamicResource FidoDangerSoftBg}"
                                BorderBrush="{DynamicResource FidoDangerBorder}" BorderThickness="1.5"
                                CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="DeleteRetryHeadline" Text="{Binding DeleteRetryHeadline}"
                                           TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource FidoDangerConfirmText}" />
                                <TextBlock IsVisible="{Binding HasDeleteRetryDetail}" Text="{Binding DeleteRetryDetail}"
                                           TextWrapping="Wrap" FontSize="11.5" FontFamily="{DynamicResource FidoMono}"
                                           Foreground="{DynamicResource FidoTextMuted}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Name="DeleteRetryDismissButton" Classes="confirmcancel" Content="Dismiss"
                                            Click="OnDeleteRetryDismissClick" IsEnabled="{Binding !IsDeleting}" />
                                    <Button x:Name="DeleteRetryButton" Classes="dangersolid" Content="↻  Retry"
                                            Click="OnDeleteRetryClick" IsEnabled="{Binding !IsDeleting}" IsTabStop="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================= 6. Flight log ============================= -->
        <Grid x:Name="LogRegion" Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,20,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,9">
                <TextBlock Grid.Column="0" Classes="label" Text="Flight log" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="1" Background="{DynamicResource FidoLogRule}"
                        VerticalAlignment="Center" Margin="10,0" />
                <!-- Take the narration with you: the whole log to the clipboard, or out to a text file -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="CopyLogButton" Classes="iconaction" Click="OnCopyLogClick"
                            IsTabStop="False" IsEnabled="{Binding HasLog}"
                            ToolTip.Tip="Copy the flight log to the clipboard">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="M11,9 L20,9 A2,2 0 0 1 22,11 L22,20 A2,2 0 0 1 20,22 L11,22 A2,2 0 0 1 9,20 L9,11 A2,2 0 0 1 11,9 Z M5,15 L4,15 A2,2 0 0 1 2,13 L2,4 A2,2 0 0 1 4,2 L13,2 A2,2 0 0 1 15,4 L15,5" />
                    </Button>
                    <Button x:Name="SaveLogButton" Classes="iconaction" Click="OnSaveLogClick"
                            IsTabStop="False" IsEnabled="{Binding HasLog}"
                            ToolTip.Tip="Save the flight log to a file">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="M12,3 V15 M8,11 L12,15 L16,11 M4,17 V20 A1,1 0 0 0 5,21 H19 A1,1 0 0 0 20,20 V17" />
                    </Button>
                </StackPanel>
            </Grid>
            <!-- MinHeight/MaxHeight are the design's content-sized panel (104 → 150 as lines land); an
                 explicit Height set from code-behind takes over once the window has slack to give. -->
            <Border x:Name="LogPanel" Grid.Row="1"
                    Background="{DynamicResource FidoLogBg}" BorderBrush="{DynamicResource FidoLogBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="15,12" MinHeight="104" MaxHeight="150">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LogLine">
                                <TextBlock Classes="logline" Text="{Binding Text}"
                                           Classes.accent="{Binding IsAccent}"
                                           Classes.ok="{Binding IsOk}"
                                           Classes.warn="{Binding IsWarn}"
                                           Classes.plain="{Binding IsPlain}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Close countdown + "keep open" escape hatch; only while an auto-close is pending -->
        <Border x:Name="CountdownBar" Grid.Row="2" IsVisible="{Binding IsClosingCountdown}" Margin="0,16,0,0"
                Background="{DynamicResource FidoGoBg}" BorderBrush="{DynamicResource FidoGo}"
                BorderThickness="2,0,0,0" CornerRadius="0,5,5,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                        Background="{DynamicResource FidoGo}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource FidoMono}" FontSize="12.5"
                           Foreground="{DynamicResource FidoTextSecondary}" Text="{Binding CountdownText}" />
                <Button Grid.Column="2" x:Name="KeepOpenButton" Classes="secondary" Content="Keep open"
                        Padding="16,7" Click="OnKeepOpenClick" />
            </Grid>
        </Border>

    </Grid>
</Window>
